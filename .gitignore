# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data & uploads
/data/*.json
/data/*.txt
/Im1.jpg
/public/uploads/gallery/*
/public/uploads/fleet/*
/public/uploads/destinations/*
!/public/uploads/gallery/.gitkeep
!/public/uploads/fleet/.gitkeep
!/public/uploads/destinations/.gitkeep

# keep WhatsApp-named originals out of git if duplicated under images/fleet
# (clean copies live in public/images/fleet)

# scrape / local tooling under data
/data/node_modules/
/data/*.html
/data/*.mjs
/data/*.js
/data/package*.json

/data/maps-scrape*.png
/data/*-scrape*.png
